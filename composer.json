{
    "name": "kirschbaum-development/monitor",
    "description": "Control points for Laravel: declare what a critical operation tolerates, bound it, record every outcome, and verify it in CI.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "laravel",
        "observability",
        "resilience",
        "circuit breaker",
        "retry",
        "structured logging",
        "tracing",
        "control points",
        "critical operations",
        "monitor"
    ],
    "autoload": {
        "psr-4": {
            "Kirschbaum\\Monitor\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/",
            "Workbench\\Monitor\\": "workbench/app/",
            "Workbench\\Database\\Factories\\": "workbench/database/factories/",
            "Workbench\\Database\\Seeders\\": "workbench/database/seeders/"
        }
    },
    "authors": [
        {
            "name": "Belisar Hoxholli",
            "email": "belisar.hoxholli@gmail.com",
            "role": "Developer"
        },
        {
            "name": "Erand Laci",
            "email": "erandlaci@gmail.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.3|^8.4|^8.5",
        "illuminate/support": "^12.0|^13.0",
        "monolog/monolog": "^3.0",
        "symfony/finder": "^7.0|^8.0",
        "kirschbaum-development/redactor": "^1.0",
        "nikic/php-parser": "^5.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.4",
        "laravel/pint": "^1.22",
        "orchestra/testbench": "^10.3|^11.0",
        "pestphp/pest": "^3.8",
        "timacdonald/log-fake": "^2.4",
        "laravel/mcp": "^1.0",
        "rector/rector": "^2.6",
        "driftingly/rector-laravel": "^2.5"
    },
    "suggest": {
        "laravel/mcp": "To let agents list control points, read their contracts and query outcomes over MCP"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Kirschbaum\\Monitor\\MonitorServiceProvider"
            ]
        }
    },
    "scripts": {
        "setup-hooks": [
            "git config core.hooksPath .githooks"
        ],
        "post-install-cmd": [
            "@setup-hooks"
        ],
        "post-autoload-dump": [
            "@clear",
            "@prepare"
        ],
        "clear": "@php vendor/bin/testbench package:purge-skeleton --ansi",
        "prepare": "@php vendor/bin/testbench package:discover --ansi",
        "build": "@php vendor/bin/testbench workbench:build --ansi",
        "serve": [
            "Composer\\Config::disableProcessTimeout",
            "@build",
            "@php vendor/bin/testbench serve --ansi"
        ],
        "lint": [
            "@php vendor/bin/pint --ansi",
            "@php vendor/bin/rector process --ansi",
            "@php vendor/bin/phpstan analyse --verbose --ansi --memory-limit=1G"
        ],
        "test": [
            "@clear",
            "@php vendor/bin/pest --parallel"
        ],
        "preflight": [
            "@php vendor/bin/pint --test --ansi",
            "@php vendor/bin/rector process --dry-run --ansi",
            "@php vendor/bin/phpstan analyse --no-progress --ansi --memory-limit=1G",
            "@php vendor/bin/pest --parallel"
        ],
        "test-coverage": [
            "@clear",
            "@php -d memory_limit=2G vendor/bin/pest --coverage --min=100"
        ],
        "mutate": [
            "@php -d memory_limit=2G vendor/bin/pest --mutate --everything --covered-only"
        ],
        "rector": [
            "@php vendor/bin/rector process --ansi"
        ],
        "rector:check": [
            "@php vendor/bin/rector process --dry-run --ansi"
        ]
    }
}
